{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheTenantZone",
      "Effect": "Allow",
      "Action": ["route53:ListResourceRecordSets"],
      "Resource": "arn:aws:route53:::hostedzone/@@ROUTE53_HOSTED_ZONE_ID@@"
    },
    {
      "Sid": "WriteHandleRecordsOnly",
      "Effect": "Allow",
      "Action": ["route53:ChangeResourceRecordSets"],
      "Resource": "arn:aws:route53:::hostedzone/@@ROUTE53_HOSTED_ZONE_ID@@",
      "Condition": {
        "ForAllValues:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": ["*.@@TENANT_ZONE@@"]
        },
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": ["A", "AAAA", "CAA"],
          "route53:ChangeResourceRecordSetsActions": ["UPSERT", "DELETE"]
        }
      }
    }
  ]
}
