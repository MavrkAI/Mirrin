# Values every host shares. render.sh reads common.env first, then the
# host's own file, which may override anything here. Only public values
# go in these files: names, addresses, key ids, public keys, bucket names.
# Secrets are systemd encrypted credentials (cloud/deploy/README.md).

# The operator zone (DNS only, at Cloudflare) and the tenant zone (the
# handles, Route 53, DNSSEC).
OPERATOR_ZONE=mirrin.app
TENANT_ZONE=mirrin.link
CLOUD_HOST=cloud.mirrin.app
DENYLIST_HOST=denylist.mirrin.app
OPS_EMAIL=ops@mirrin.app
ABUSE_EMAIL=abuse@mirrin.app
SECURITY_EMAIL=security@mirrin.app

# The control-plane VM and the probe VMs (for the operator zone).
CP_IPV4=203.0.113.30
CP_IPV6=2001:db8:3::30
PROBE_B_IPV4=203.0.113.40
PROBE_B_IPV6=2001:db8:4::40
PROBE_C_IPV4=203.0.113.50
PROBE_C_IPV6=2001:db8:5::50

# The tenant zone's Route 53 hosted zone (tenant-zone.md, step 1).
ROUTE53_HOSTED_ZONE_ID=ZREPLACEME

# The relays' reserved addresses. Changing one is the relay IP migration
# runbook (cloud/ops/RUNBOOK.md), not an edit here alone.
R1_IPV4=192.0.2.10
R1_IPV6=2001:db8:1::10
R2_IPV4=198.51.100.20
R2_IPV6=2001:db8:2::20

# Signing keys in use: `mirrin-cloud keys public --dir DIR` prints them.
# The public halves also ship in internal/entitle/keys.go a release ahead.
ENT_KID=ent-2026a
ENT_PUB=REPLACE_WITH_THE_ENT_PUBLIC_KEY
DL_KID=dl-2026a
DL_PUB=REPLACE_WITH_THE_DL_PUBLIC_KEY
# The second kid of each purpose, only during a key rotation
# (cloud/ops/RUNBOOK.md): the next kid from a release before the switch,
# then the old kid until it retires. Empty the rest of the year.
ENT_KID2=
ENT_PUB2=
DL_KID2=
DL_PUB2=

# The canary twin's handle, and where the probes are.
CANARY_HANDLE=canary-ops-7
PROBE_B_HOST=probe-b.ops.mirrin.app
PROBE_C_HOST=probe-c.ops.mirrin.app
WATCH_HOST=watch.ops.mirrin.app

# Cloudflare R2 (the account id is not secret).
R2_ACCOUNT_ID=REPLACE_WITH_THE_R2_ACCOUNT_ID
R2_BACKUP_BUCKET=mirrin-backups
R2_LITESTREAM_BUCKET=mirrin-litestream
R2_DENYLIST_BUCKET=mirrin-denylist

# Mail for alerts and abuse notices (the password is a credential).
SMTP_ADDR=smtp.example.net:587
