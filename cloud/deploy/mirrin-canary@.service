# mirrin-canary, one instance per role (cloud/deploy/README.md):
#   control-plane VM: mirrin-canary@twin, @probe, @watch, @mirror
#   probe VMs:        mirrin-canary@probe
# Installed as /etc/systemd/system/mirrin-canary@.service by install.sh.

[Unit]
Description=mirrin-canary %i
Documentation=https://github.com/MavrkAI/Mirrin/blob/main/cloud/ops/ALERTS.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/bin/mirrin-canary check-config --config /etc/mirrin-canary/canary.yaml --role %i
ExecStart=/usr/local/lib/mirrin/with-credentials /usr/local/bin/mirrin-canary %i --config /etc/mirrin-canary/canary.yaml
Restart=always
RestartSec=5s

# Each role's secrets come in a drop-in,
# mirrin-canary@ROLE.service.d/credentials.conf (canary-credentials-ROLE.conf
# here), so a role loads only its own. The twin needs none.

DynamicUser=yes
# The twin's device key, entitlement and certificate: /var/lib/mirrin-canary-twin.
StateDirectory=mirrin-canary-%i
StateDirectoryMode=0700
ConfigurationDirectory=mirrin-canary
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
