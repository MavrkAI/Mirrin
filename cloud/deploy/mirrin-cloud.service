# mirrin-cloud: the Mirrin Cloud control plane (cloud/deploy/README.md).
# Installed as /etc/systemd/system/mirrin-cloud.service by install.sh.
#
# The signing keys and every other secret are systemd encrypted
# credentials: sealed to this machine (and its TPM when it has one) under
# /etc/credstore.encrypted, decrypted by systemd into a private in-memory
# directory only this service can read, for as long as it runs. A copy of
# the disk alone does not give them up. Making them: README.md, "Secrets".

[Unit]
Description=mirrin-cloud: the Mirrin Cloud control plane
Documentation=https://github.com/MavrkAI/Mirrin/blob/main/cloud/ops/RUNBOOK.md
After=network-online.target litestream.service
Wants=network-online.target litestream.service

[Service]
User=mirrin-cloud
Group=mirrin-cloud
ExecStart=/usr/local/lib/mirrin/with-credentials /usr/local/bin/mirrin-cloud serve --config /etc/mirrin-cloud/cloud.yaml
Restart=always
RestartSec=2s
TimeoutStopSec=30s

# The keys that sign: keys.dir is $CREDENTIALS_DIRECTORY, and every
# <kid>.pem there is published at /v1/keys. During a rotation ENT_KID2 /
# DL_KID2 name the second kid: the next one before the switch, the old
# one after it until it retires (RUNBOOK.md, "Key rotation").
LoadCredentialEncrypted=@@ENT_KID@@.pem:/etc/credstore.encrypted/@@ENT_KID@@.pem
LoadCredentialEncrypted=@@DL_KID@@.pem:/etc/credstore.encrypted/@@DL_KID@@.pem
@@?ENT_KID2@@LoadCredentialEncrypted=@@ENT_KID2@@.pem:/etc/credstore.encrypted/@@ENT_KID2@@.pem
@@?DL_KID2@@LoadCredentialEncrypted=@@DL_KID2@@.pem:/etc/credstore.encrypted/@@DL_KID2@@.pem
# Exported as environment variables by with-credentials.
LoadCredentialEncrypted=PADDLE_API_KEY:/etc/credstore.encrypted/PADDLE_API_KEY
LoadCredentialEncrypted=PADDLE_WEBHOOK_SECRET:/etc/credstore.encrypted/PADDLE_WEBHOOK_SECRET
LoadCredentialEncrypted=ROUTE53_ACCESS_KEY_ID:/etc/credstore.encrypted/ROUTE53_ACCESS_KEY_ID
LoadCredentialEncrypted=ROUTE53_SECRET_ACCESS_KEY:/etc/credstore.encrypted/ROUTE53_SECRET_ACCESS_KEY
LoadCredentialEncrypted=R2_ACCESS_KEY_ID:/etc/credstore.encrypted/R2_ACCESS_KEY_ID
LoadCredentialEncrypted=R2_SECRET_ACCESS_KEY:/etc/credstore.encrypted/R2_SECRET_ACCESS_KEY

# cloud.db lives here; Litestream (same user) replicates it.
StateDirectory=mirrin-cloud
StateDirectoryMode=0750
ConfigurationDirectory=mirrin-cloud
UMask=0027

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
