# mirrin-relay for Mirrin Cloud: r1 and r2 (cloud/deploy/README.md).
# The same unit as packaging/relay/mirrin-relay.service, plus the SMTP
# credentials relay-notify uses to mail the abuse inbox. Installed as
# /etc/systemd/system/mirrin-relay.service by install.sh.

[Unit]
Description=mirrin-relay @@RELAY_ID@@: SNI passthrough for Mirrin Cloud
Documentation=https://github.com/MavrkAI/Mirrin/blob/main/cloud/ops/RUNBOOK.md
After=network-online.target
Wants=network-online.target
# Restarting in a loop helps nobody: after 5 failures in 10 minutes it
# stays down, the canary emails "one relay down" and daemons use the
# other relay.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
ExecStartPre=/usr/local/bin/mirrin-relay check-config --config /etc/mirrin-relay/relay.yaml
ExecStart=/usr/local/bin/mirrin-relay serve --config /etc/mirrin-relay/relay.yaml
Restart=always
RestartSec=2s
# SIGTERM drains: daemons are told to use the other relay, and spliced
# connections get up to 30 s before everything closes.
KillSignal=SIGTERM
TimeoutStopSec=45s

# Encrypted with systemd-creds on this host (README.md, "Secrets"). The
# relay itself needs no secret; relay-notify reads these.
LoadCredentialEncrypted=SMTP_USERNAME:/etc/credstore.encrypted/SMTP_USERNAME
LoadCredentialEncrypted=SMTP_PASSWORD:/etc/credstore.encrypted/SMTP_PASSWORD

DynamicUser=yes
StateDirectory=mirrin-relay
StateDirectoryMode=0700
ConfigurationDirectory=mirrin-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0077
LimitNOFILE=1048576

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
