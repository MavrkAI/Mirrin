# systemd unit for a self-hosted mirrin-relay (docs/relay-selfhost.md).
#   install -m 0755 mirrin-relay-linux-amd64 /usr/local/bin/mirrin-relay
#   install -m 0644 -D relay.yaml /etc/mirrin-relay/relay.yaml
#   install -m 0644 mirrin-relay.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now mirrin-relay
# relay.yaml holds only public keys, so 0644 is fine.
# A relay set up before the rename runs as antbot-relay. Move it over first,
# keeping its settings and its state (the ACME account and certificate):
#   systemctl disable --now antbot-relay
#   mv /etc/antbot-relay /etc/mirrin-relay
#   mv /var/lib/private/antbot-relay /var/lib/private/mirrin-relay
# then set state_dir in /etc/mirrin-relay/relay.yaml to /var/lib/mirrin-relay
# (the only place this unit lets it write), install the binary and this unit
# as above, and delete antbot-relay.service. Its metrics are now named
# mirrin_relay_* (they were antbot_relay_*): update alert rules.

[Unit]
Description=mirrin-relay: SNI passthrough for Mirrin twins
Documentation=https://github.com/MavrkAI/Mirrin/blob/main/docs/relay-selfhost.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/bin/mirrin-relay check-config --config /etc/mirrin-relay/relay.yaml
ExecStart=/usr/local/bin/mirrin-relay serve --config /etc/mirrin-relay/relay.yaml
Restart=always
RestartSec=2s
# SIGTERM drains: daemons are told to use another relay, and spliced
# connections get up to 30 s before everything closes.
KillSignal=SIGTERM
TimeoutStopSec=45s

# No root: a throwaway user, with only the right to bind :443 and :80.
# StateDirectory is state_dir in relay.yaml: the ACME cache and the last
# good deny list.
DynamicUser=yes
StateDirectory=mirrin-relay
StateDirectoryMode=0700
ConfigurationDirectory=mirrin-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0077
LimitNOFILE=1048576

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
